# Base44 Documentation Tool - .gitignore

# Database files (will be regenerated)
*.db
*.sqlite
*.sqlite3

# Cache directories (will be recreated)
cache/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
.cache/

# Playwright browsers (will be downloaded during setup)
.playwright/

# Local configuration
config.local.*
.env.local

# Runtime directories that will be created
base44-tool/
temp/
downloads/

# Test outputs
test-output/
screenshots/

# OS generated files
.DS_Store?
.Spotlight-V100
.Trashes
